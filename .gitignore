# Unreal Engine 5 - .gitignore

# Carpetas generadas (se regeneran solas, NO subirlas)
Binaries/
DerivedDataCache/
Intermediate/
Saved/
Build/

# Archivos de IDE
.vs/
.idea/
.vscode/
*.VC.db
*.VC.opendb
*.opensdf
*.sdf
*.suo
*.xcodeproj
*.xcworkspace
*.sln
*.code-workspace

# Archivos compilados
*.exe
*.dll
*.pdb
*.exp
*.lib
*.obj
*.ilk
*.o
*.a
*.dylib
*.so
*.app

# Otros
*.tmp
*.log
.DS_Store
Thumbs.db

# Plugins (solo ignorar sus binarios/intermedios)
Plugins/**/Binaries/
Plugins/**/Intermediate/
